[submodule "lib/layerzero"]
	path = lib/layerzero
	url = https://github.com/LayerZero-Labs/LayerZero-v2.git
[submodule "lib/layerzero-devtools"]
	path = lib/layerzero-devtools
	url = https://github.com/LayerZero-Labs/devtools.git
[submodule "lib/layerzero-v1"]
